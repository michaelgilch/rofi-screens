#!/bin/bash
# rofi-screens: rofi menus for displays. Each lib/*.sh file other than
# screens-lib.sh is a backend (resolution, ...) that registers itself when
# sourced.
#
# Usage: rofi-screens [backend | --init | --xorg-conf | --list]

set -o pipefail

usage() {
    local names=() i
    for i in "${backend_idx[@]}"; do
        names+=("${_backend_names[i]}")
    done
    local IFS='|'
    echo "Usage: ${0##*/} [${names[*]}|--init|--xorg-conf|--list]" >&2
    exit 2
}

# The library sits next to the script in the working tree (and under `make
# link`, which symlinks the script), or in $PREFIX/lib/rofi-screens once
# installed.
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
for libdir in "$here/lib" "$here/../lib/rofi-screens"; do
    [[ -f $libdir/screens-lib.sh ]] && break
done
if [[ ! -f $libdir/screens-lib.sh ]]; then
    echo "${0##*/}: helper library not found" >&2
    exit 1
fi

# shellcheck source=lib/screens-lib.sh
source "$libdir/screens-lib.sh"

# The config is loaded before the backends so they can set their own defaults
# from it when sourced.
config="${XDG_CONFIG_HOME:-$HOME/.config}/rofi-screens/config"
# shellcheck source=/dev/null
[[ -f $config ]] && source "$config"

read -ra rofi_args <<< "${ROFI_ARGS:-}"

for lib in "$libdir"/*.sh; do
    [[ $lib == */screens-lib.sh ]] && continue
    # shellcheck source=/dev/null
    source "$lib"
done
mapfile -t backend_idx < <(backend_indexes)

# Entries for unavailable backends are left out. Row keys are registry indexes.
top_menu() {
    local key i
    while :; do
        menu_reset
        for i in "${backend_idx[@]}"; do
            "${_backend_prefixes[i]}_available" &&
                row "$i" "${_backend_labels[i]}" "${_backend_icons[i]}"
        done
        if ((${#_keys[@]} == 0)); then
            notify "rofi-screens" "Nothing to manage: no backend is available"
            exit 0
        fi
        key=$(menu "Screens") || exit 0
        "${_backend_prefixes[key]}_menu" back
    done
}

case ${1:-} in
"") top_menu ;;
# Session setup, e.g. from window manager startup or an autorandr preswitch
# hook. Runs <prefix>_init for every backend that defines one.
--init)
    for i in "${backend_idx[@]}"; do
        if declare -F "${_backend_prefixes[i]}_init" >/dev/null; then
            "${_backend_prefixes[i]}_init"
        fi
    done
    exit 0
    ;;
# Xorg config for whatever backends can set up from X startup, from every
# <prefix>_xorg_conf. Meant for /etc/X11/xorg.conf.d/.
--xorg-conf)
    echo "# Generated by rofi-screens --xorg-conf"
    for i in "${backend_idx[@]}"; do
        if declare -F "${_backend_prefixes[i]}_xorg_conf" >/dev/null; then
            echo
            "${_backend_prefixes[i]}_xorg_conf" || exit 1
        fi
    done
    exit 0
    ;;
# "name<TAB>label<TAB>icon" per backend, for generating launcher entries.
--list)
    for i in "${backend_idx[@]}"; do
        printf '%s\t%s\t%s\n' "${_backend_names[i]}" "${_backend_labels[i]}" \
            "${_backend_icons[i]}"
    done
    exit 0
    ;;
esac
for i in "${backend_idx[@]}"; do
    if [[ ${_backend_names[i]} == "$1" ]]; then
        "${_backend_prefixes[i]}_menu"
        exit 0
    fi
done
usage
